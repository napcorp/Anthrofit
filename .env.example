# ==============================================================================
# AnthroFit OS — Environment Template (.env.example)
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# Google Gemini API Key (Required for AI Product Intelligence & Web Sizing Lookup)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative variable names supported:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Local Development Server Settings (Optional)
HOST=127.0.0.1
PORT=8000
